# Copy to .env and fill in the values for your network.
# .env is local only. Do not commit it.

# Where this remote listens. Use a LAN address, not the public internet.
HOST=0.0.0.0
PORT=8095
HTTPS_PORT=8443

# How to find the projector. Set XGIMI_HOST, or XGIMI_MAC, or leave both
# empty when exactly one Android device is already connected in `adb devices`.
# XGIMI_HOST is the ADB address, usually the projector IP and port 5555.
XGIMI_HOST=
XGIMI_MAC=
# Optional. When set, a device is accepted only if the serial or model matches.
XGIMI_SERIAL=
XGIMI_MODEL=
# Set to 1 to allow a subnet scan for port 5555. Off unless you opt in.
XGIMI_SCAN=0

# Private ADB key from `adb keygen` or from the first successful adb pairing.
# Example: /home/you/.android/adbkey
ADB_VENDOR_KEYS=

# Extra addresses to put on the local HTTPS certificate. Comma-separated.
# Leave empty to use this machine's own LAN addresses.
LAN_IP=

# Public https origin, only if you already terminate TLS somewhere else
# (for example Tailscale Serve) and want the install hint to point there.
PUBLIC_HTTPS_URL=

# Where history, stars, and the TLS files are stored. Default is ./data
STORAGE_PATH=
TLS_DIR=
